rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function estaLogado() {
      return request.auth != null;
    }

    function dadosDoUsuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ehAdministrador() {
      return estaLogado() && dadosDoUsuario().papel == 'administrador';
    }

    function podeEditar() {
      return estaLogado() &&
        (dadosDoUsuario().papel == 'administrador' || dadosDoUsuario().papel == 'cadastrador');
    }

    function temAcessoEntidade(entidadeId) {
      return ehAdministrador() || (entidadeId in dadosDoUsuario().unidadesGestoras);
    }

    // Fotos e croqui dos boletins: entidades/{entidadeId}/boletins/{boletimId}/fotos/{arquivo}
    // e entidades/{entidadeId}/boletins/{boletimId}/croqui.png
    match /entidades/{entidadeId}/boletins/{boletimId}/{caminhoRestante=**} {
      allow read: if temAcessoEntidade(entidadeId);
      allow write: if podeEditar() && temAcessoEntidade(entidadeId)
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if podeEditar() && temAcessoEntidade(entidadeId);
    }
  }
}
